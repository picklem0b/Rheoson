{
  "name": "rheoson",
  "version": "3.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @rheoson/web dev",
    "dev:api": "pnpm --filter @rheoson/api dev:bridge",
    "build": "pnpm --filter @rheoson/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rheoson/api db:generate",
    "db:migrate": "pnpm --filter @rheoson/api db:migrate",
    "db:studio": "pnpm --filter @rheoson/api db:studio",
    "dev:worker": "pnpm --filter @rheoson/api dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
