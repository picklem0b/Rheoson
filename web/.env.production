# ── Rheoson web — production / native builds ─────────────────────
# Loaded by `npm run build` (APK, static hosting). CI overrides these
# with dashboard secrets when present; this file is the local default.
# Full key documentation: .env.example

# Backend API origin — hardcoded so the Capacitor WebView never resolves
# /api against its own bundled assets (the "HTML instead of JSON" bug).
VITE_API_URL=https://rheoson-api-9e4c.onrender.com

# Clerk publishable key — same instance as the backend's sk_ key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Z2xhZC10dW5hLTkwMDQuY2xlcmsuYWNjb3VudHMuZGV2JA
