{
    "name": "rheoson-web",
    "private": true,
    "version": "2.11.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "cap:sync": "npx cap sync android",
        "cap:open": "npx cap open android",
        "cap:run": "npx cap run android",
        "cap:build": "npm run build && npx cap sync android",
        "build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
        "test": "vitest run",
        "generate:types": "cd ../api && uv run python scripts/export_openapi.py && cd ../web && npx openapi-typescript src/types/openapi.json -o src/types/api-generated.ts",
        "test:watch": "vitest",
        "prebuild": "npm run generate:types"
    },
    "dependencies": {
        "@capacitor/android": "^8.4.1",
        "@capacitor/core": "^8.4.1",
        "@capacitor/filesystem": "^8.1.3",
        "@capacitor/network": "^8.0.1",
        "@tanstack/react-query": "^5.28.0",
        "@tanstack/react-query-devtools": "^5.28.0",
        "clsx": "^2.1.0",
        "framer-motion": "^11.1.7",
        "howler": "^2.2.4",
        "idb": "^8.0.3",
        "lucide-react": "^0.378.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.23.1",
        "socket.io-client": "^4.7.5",
        "tailwind-merge": "^2.3.0",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/howler": "^2.2.11",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.19",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.6",
        "jsdom": "^30.0.1",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.3",
        "typescript": "^5.4.5",
        "vite": "^5.2.11",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11",
        "workbox-background-sync": "^7.4.1",
        "workbox-cacheable-response": "^7.4.1",
        "workbox-core": "^7.4.1",
        "workbox-expiration": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-range-requests": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1",
        "workbox-window": "^7.4.1"
    }
}
