# ──────────────────────────────────────────────────────────────────
#  Rheoson web — environment template
#
#  cp web/.env.example web/.env            # local dev (usually unneeded)
#  cp web/.env.example web/.env.production # native/CI builds — REQUIRED
#
#  Only VITE_* keys exist here. Backend keys (MUSIC_DIR, CORS_ORIGINS,
#  CLERK_SECRET_KEY…) do nothing in the frontend — they belong in api/.env.
#
#  Which file applies when:
#    • .env               every build, lowest priority
#    • .env.production    `npm run build` only (APK, static hosting)
#    • dashboard secrets  Render/CI override both when set
# ──────────────────────────────────────────────────────────────────

# Backend API origin — no trailing slash.
#   Dev:        leave unset (Vite proxies /api → http://127.0.0.1:8000,
#               override the proxy target with RHEOSON_API_TARGET)
#   APK/native: MUST be set — the WebView has no proxy; a relative /api
#               resolves against bundled assets and returns index.html
#               (the "Backend returned HTML instead of JSON" bug).
#   Same-origin deployments (nginx serving SPA+API): set to '' EXPLICITLY.
# VITE_API_URL=https://rheoson-api-9e4c.onrender.com

# Clerk publishable key — pk_test_… / pk_live_….
# Signs users in; without it auth UI is hidden and the app runs in
# local-only mode (everything else still works).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Optional: remote sink for client error logs (lib/logger.ts).
# VITE_ERROR_ENDPOINT=https://…/api/client-errors
