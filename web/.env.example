[TEMPLATE]
# ── API origin ────────────────────────────────────────────────
#
# Copy this file to web/.env.production for APK / static builds — .env and
# .env.production are git-ignored on purpose (never commit deployment hosts).
#
#   APK (Capacitor)   VITE_API_URL=https://rheoson-api-9e4c.onrender.com
#   Render (static)   set it in Dashboard → Environment instead of a file
#   VPS (same origin) VITE_API_URL=''   ← nginx proxies /api and /socket.io
#
# An ABSOLUTE origin is mandatory on native: the WebView has no proxy, so a
# relative /api is answered by the bundled asset handler with index.html and
# every request fails as "Backend returned HTML instead of JSON".
#
# The REST client uses `${origin}/api`; Socket.IO takes the bare origin.
# No trailing slash.

VITE_API_URL=https://rheoson-api-9e4c.onrender.com

# ── Clerk ─────────────────────────────────────────────────────
# Publishable key (pk_test_… / pk_live_…), never the secret key. Without a
# valid key the app runs in local mode (no accounts) instead of crashing.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
