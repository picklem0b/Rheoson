# Copy to .env, which Vite reads and git ignores.

# The API origin plus its version prefix. Production is two origins: the app on
# Vercel and the worker on Workers, so this is the only place the host appears.
# Leave it unset in development and every request stays same-origin through the
# Vite proxy.
# VITE_API_BASE_URL=https://rheoson-api.example.workers.dev/api/v1
