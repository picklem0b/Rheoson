{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },

    "@rheoson/client#build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@rheoson/client#typecheck": {
      "dependsOn": ["build"]
    }
  }
}
