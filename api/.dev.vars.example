# Copy to .dev.vars, which Wrangler reads and git ignores.

ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=120

# The Vite dev origin, so the allowlist is exercised locally the way it is in
# production. Localhost is also allowed by shape outside production.
APP_ORIGINS=http://localhost:3000

# Absent means the app runs without a database: accounts answer from the token.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Absent means /me answers 401 rather than pretending a session is valid.
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
