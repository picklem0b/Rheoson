# Rheoson API — VPS deployment template
#
#   cp api/.env.vps.example api/.env   # then fill in the REQUIRED values
#
# This file is for docker-compose.vps.yml. Unlike render.yaml, everything
# here runs on YOUR disk — downloads, likes, history, playlists, follows,
# and preference sync all persist across redeploys.

# ── Runtime ─────────────────────────────────────────────────────
ENV=production

# ── REQUIRED in production — the app refuses to start without them ──
# Clerk: dashboard.clerk.com → your app → API keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Database ────────────────────────────────────────────────────
# MongoDB Atlas M0 (free) is fine — the VPS only needs outbound HTTPS.
# Local mongod on the VPS also works; then use mongodb://mongo:27017
# and add a mongo service to docker-compose.vps.yml.
MONGODB_URL=
MONGODB_DB_NAME=rheoson

# ── Library locations ───────────────────────────────────────────
# Container paths; docker-compose.vps.yml binds them to ./data on the
# host. Do not change these without changing the compose volumes too.
MUSIC_DIR=/data/music
DOWNLOADS_DIR=/data/downloads
EXTRA_MUSIC_DIRS=[]

# ── Download pipeline ───────────────────────────────────────────
AUDIO_FORMAT=mp3
AUDIO_QUALITY=0
MAX_CONCURRENT_DOWNLOADS=4
# Durable warm-stream cache: completed streams are kept here and served
# instantly on replay, even after a restart. Empty = memory-only cache.
# On VPS use ./data/stream-cache (already persisted). 1024 MB budget.
STREAM_CACHE_DIR=
STREAM_CACHE_MAX_MB=1024

# ── CORS ────────────────────────────────────────────────────────
# Same-origin deployment means the browser never cross-origin calls the
# API, but the APK build still does. List your APK/API origins; the
# built-in origin list is additive with this value.
# CORS_ORIGINS=["https://your-apk-or-web-origin.example"]

# ── Spotify URL resolution (optional) ───────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
