# ──────────────────────────────────────────────────────────────────
#  Rheoson API — environment template
#
#  cp api/.env.example api/.env     # then fill in the REQUIRED block
#
#  Rules that keep this file honest:
#    • ONE key per line — keys running together corrupt every value after
#      the first, and pydantic-settings silently reads the LAST duplicate.
#    • Backend keys only. Anything starting with VITE_ belongs to the
#      frontend and does nothing here (see web/.env.example).
#    • Lists use JSON syntax: KEY=["a","b"] — no shell-style quoting.
# ──────────────────────────────────────────────────────────────────

# ── REQUIRED in production (app refuses to start without these) ──
ENV=production                          # development | production
SECRET_KEY=change-me-to-a-long-random-string
CLERK_SECRET_KEY=sk_test_xxxx           # Clerk Dashboard → API keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxx      # must be the SAME instance as the sk_ key

# ── MongoDB ───────────────────────────────────────────────────────
# Local dev default works with no setup; Atlas URL embeds user:password.
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/rheoson?retryWrites=true&w=majority
MONGODB_DB_NAME=rheoson

# ── Storage ───────────────────────────────────────────────────────
# Termux default lives under the app home; Render uses /tmp (ephemeral).
MUSIC_DIR=/data/data/com.termux/files/home/Rheoson/music
DOWNLOADS_DIR=/data/data/com.termux/files/home/Rheoson/downloads
# Extra device folders scanned alongside MUSIC_DIR (JSON list):
# EXTRA_MUSIC_DIRS=["/storage/emulated/0/Music"]

# ── Durable warm-stream cache ─────────────────────────────────────
# Copies of streamed remote audio, served from disk on repeat plays.
# Default: system temp dir (enabled everywhere). Point at real storage to
# persist, or set empty to disable.
# STREAM_CACHE_DIR=/tmp/Rheoson_stream_cache
# STREAM_CACHE_MAX_MB=1024

# ── Downloads ─────────────────────────────────────────────────────
# AUDIO_FORMAT=mp3                       # mp3 | m4a | flac | ogg | opus
# AUDIO_QUALITY=0                        # yt-dlp quality string
# MAX_CONCURRENT_DOWNLOADS=4

# ── CORS ──────────────────────────────────────────────────────────
# ADDITIVE override on top of the builtins in main.py. Web SPA origins,
# local dev ports, and capacitor://localhost. Never list the API's own
# host, never use "*".
# CORS_ORIGINS=["https://your-spa.example.com","capacitor://localhost"]

# ── Optional integrations ─────────────────────────────────────────
# CLERK_WEBHOOK_SECRET=whsec_xxxx        # Clerk webhooks → /api/auth/webhook
# REDIS_URL=redis://default:pass@host:6379   # distributed rate limiting
# SPOTIFY_CLIENT_ID=                     # enables Spotify URL resolution
# SPOTIFY_CLIENT_SECRET=
# RENDER_API_URL=                        # keep-alive self-ping (Render only)

# ── Rate limits (requests/min) — sane defaults, tune per instance ─
# RATE_LIMIT_SEARCH=30
# RATE_LIMIT_DOWNLOAD=10
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_STREAM=300
# RATE_LIMIT_LYRICS=60

# ── Instance administration ───────────────────────────────────────
# Clerk subs allowed to mutate instance config. Empty = single-admin dev.
# ADMIN_SUBS=["user_xxxx"]
