# Rheoson API — environment template
#
# Copy to `.env` and fill in. Every variable is optional unless marked
# REQUIRED. The full reference with semantics and production requirements
# lives in docs/DEPLOYMENT.md; the security model is in docs/AUTH.md.

# ── Runtime ───────────────────────────────────────────────────
# "development" enables the dev identity fallback when Clerk is not
# configured (local, single-user). "production" fails closed: Clerk is
# REQUIRED and SECRET_KEY must be set or the app refuses to start.
ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ── Library locations ─────────────────────────────────────────
# MUSIC_DIR is the primary library; downloads land here by default.
# EXTRA_MUSIC_DIRS (comma-separated JSON array) are additional scanned
# directories, e.g. ["https://gh.gh.gh.gh/storage/emulated/0/Music"].
MUSIC_DIR=/data/data/com.termux/files/home/Rheoson/music
DOWNLOADS_DIR=/data/data/com.termux/files/home/Rheoson/downloads

# ── Download pipeline ─────────────────────────────────────────
AUDIO_FORMAT=mp3                # mp3 | opus | m4a | flac | wav
AUDIO_QUALITY=0                 # yt-dlp audio quality (0 = best)
MAX_CONCURRENT_DOWNLOADS=4

# ── MongoDB (user data, history, playlists, taste profile) ───
# Optional — without it the API degrades to the local JSON mirror
# (see docs/DATA.md). REQUIRED for multi-user or cross-device sync.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=rheoson

# ── Clerk authentication ──────────────────────────────────────
# REQUIRED together in production (ENV=production refuses to start
# without a Clerk secret key). Get them from the Clerk dashboard.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# REQUIRED in production to accept user lifecycle events:
CLERK_WEBHOOK_SECRET=

# ── Redis (optional — rate-limit / cache backend) ─────────────
REDIS_URL=

# ── Internal signing secret ───────────────────────────────────
# REQUIRED in production (startup validation enforces it).
SECRET_KEY=change-me-in-production

# ── Spotify (optional — better search/metadata resolution) ───
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── CORS additive override ────────────────────────────────────
# Extra origins on top of the builtins in app/main.py (Render hosts,
# localhost, the APK WebView origin). JSON array.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Per-IP rate limits (requests per minute) ──────────────────
RATE_LIMIT_SEARCH=30
RATE_LIMIT_DOWNLOAD=10
RATE_LIMIT_AUTH=20
RATE_LIMIT_STREAM=300
RATE_LIMIT_LYRICS=60

# ── Instance administration ───────────────────────────────────
# Clerk subs allowed to mutate instance configuration (directories,
# rescan). JSON array; empty = single-admin dev setups.
ADMIN_SUBS=[]

# ── Render keep-alive (optional) ──────────────────────────────
# Full URL of the deployed API to ping every 14 minutes.
RENDER_API_URL=
