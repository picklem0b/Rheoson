# Copy to infra/.env and fill in. Compose reads this file automatically.
#
# Development defaults are already in compose.yml; the values that must be
# real in any shared deployment are the tokens and the Clerk keys.

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=rheoson
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rheoson

# ── Service tokens ────────────────────────────────────────────
# The relay and the engine refuse anonymous callers once these are set, and
# the server presents them. Generate with: openssl rand -hex 32
ENGINE_TOKEN=change-me-engine-token
RELAY_TOKEN=change-me-relay-token

# ── Search ────────────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-meili-key

# ── Clerk (same accounts as the current stack) ────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_PUBLISHABLE_KEY=

# ── Public edge ───────────────────────────────────────────────
# Production: the real domain so Caddy can obtain a certificate.
SITE_ADDRESS=localhost
PUBLIC_API_URL=http://localhost:4000

# ── Logging ───────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
